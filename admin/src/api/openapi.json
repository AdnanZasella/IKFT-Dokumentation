          "id" : {
            "format" : "uuid",
            "type" : "string"
          },
          "memberId" : {
            "format" : "uuid",
            "type" : "string"
          },
          "memberName" : {
            "type" : "string"
          },
          "startDate" : {
            "format" : "date",
            "type" : "string"
          },
          "type" : {
            "enum" : [ "ORDINARY", "TEMPORARY" ],
            "type" : "string"
          }
        },
        "required" : [ "endDate", "id", "memberId", "memberName", "startDate", "type" ],
        "type" : "object"
      },
      "AuditEntry" : {
