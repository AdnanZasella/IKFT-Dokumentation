{
  "components" : {
    "schemas" : {
      "AccountInfo" : {
        "properties" : {
          "holderName" : {
            "type" : [ "string", "null" ]
          },
          "mustChangePassword" : {
            "type" : "boolean"
          },
          "role" : {
            "enum" : [ "ADMIN", "DOCUMENTER" ],
            "type" : "string"
          }
        },
        "required" : [ "mustChangePassword", "role" ],
        "type" : "object"
      },
      "AppointRequest" : {
        "properties" : {
          "memberId" : {
            "format" : "uuid",
            "type" : "string"
          },
          "startDate" : {
            "format" : "date",
            "type" : "string"
          }
        },
        "required" : [ "memberId", "startDate" ],
        "type" : "object"
      },
      "AppointmentResponse" : {
        "properties" : {
