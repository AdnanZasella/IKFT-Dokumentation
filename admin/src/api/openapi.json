            "type" : "array"
          },
          "createdAt" : {
            "format" : "date-time",
            "type" : "string"
          },
          "entityId" : {
            "format" : "uuid",
            "type" : "string"
          },
          "entityType" : {
            "enum" : [ "MEMBER", "ACCOUNT", "DOCUMENTER_ASSIGNMENT" ],
            "type" : "string"
          },
          "holderName" : {
            "type" : [ "string", "null" ]
          },
